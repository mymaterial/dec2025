postgres   : default administrative connection database
template0  : unmodifiable empty database
template1  : default template for new databases

### copy/clone template1 to a
postgres=# create database a;
CREATE DATABASE

### copy/clone template0 to b
postgres=# create database b template template0;
CREATE DATABASE

### copy/clone database a to database c
postgres=# create database c template a;
CREATE DATABASE

user : is one who controls your database/schema
schema : is one that holds your tables
databases: is the logical container for multiple schemas

